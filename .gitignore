# Environments
.venv/
env/
venv/
ENV/

# IDEs and Text Editors
.idea/
.vscode/
*.swp
*.swo

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/

# Build artefacts
*.egg-info/
dist/
build/

# Tooling caches
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# Node / pnpm (when skills/ gets compiled by teammate D)
node_modules/
pnpm-lock.yaml

results/
*.results
# uv
.uv/

# Local trustroom socket
*.sock

logs/
# Runtime logs (signed audit logs, agent action logs, harness output)
*.log

# Local per-agent DelftClaw/OpenClaw configs
configs/*.local.env
# Per-host overrides (Tailscale IPs, QWEN_BASE_URL/MODEL, BTC_NETWORK).
# Tracked example lives at configs/host.env.example.
configs/host.env

# pull_sync_demo writes signed logs + per-source peer caches here for
# inspection; regenerated on every run
examples/pull_sync_artifacts/
/results/

# Track the curated official result artifacts shipped for paper
# reproducibility (security/<layer>/results/), overriding the generic
# results/ and *.log ignores above. Scratch results/ at the repo root
# stays ignored.
!security/**/results/
!security/**/results/**
