[Unit]
Description=DelftClaw Seedbox Audit Loop
After=delftclaw-gateway.service
Wants=delftclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/root/DelftClaw
Environment=PYTHONPATH=/root/DelftClaw
Environment=DELFTCLAW_GATEWAY_URL=http://127.0.0.1:8765
Environment=DELFTCLAW_AGENT_ID=vuk-vps-agent
ExecStart=/root/DelftClaw/.venv/bin/python -m security.integration.audit_seedboxes --interval-seconds 30 --max-iterations 0
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
