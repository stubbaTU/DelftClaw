[Unit]
Description=DelftClaw MCP server (instance %i)
After=network-online.target ollama.service
# Wants= not Requires=: the MCP server compiles overlays against the LLM at
# ${LLM_BASE_URL}, which may be an external endpoint (the LLM proxy / an
# external GPU host) rather than local Ollama. Hard-Requiring Ollama would
# block startup on VPSes that don't run it locally.
Wants=network-online.target ollama.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=delftclaw
Group=delftclaw
WorkingDirectory=/opt/delftclaw
# Every per-instance value (seed file path, ports, HOME, publish-overlay
# args) is supplied by the env file deploy/scenario_boot.py drops at
# /etc/delftclaw/instances/<scenario>-<agent>.env. PYTHONPATH must be set
# in the env file too — systemd's templated units don't inherit it.
EnvironmentFile=/etc/delftclaw/instances/%i.env
ExecStart=/opt/delftclaw/venv/bin/python -m agent \
    --seed-file ${SEED_FILE} \
    --network ${NETWORK} \
    --btc-network ${BTC_NETWORK} \
    --initial-balance-sats ${INITIAL_BALANCE_SATS} \
    --save-dir ${HOME}/torrents \
    --address ${IPV8_HOST} --port ${IPV8_PORT} \
    --publish-overlay ${PUBLISH_OVERLAY} \
    --llm-base-url ${LLM_BASE_URL} \
    --llm-model ${LLM_MODEL} \
    mcp --mcp-host ${MCP_HOST} --mcp-port ${MCP_PORT} \
        --signed-log-host ${SIGNED_LOG_HOST} --signed-log-port ${SIGNED_LOG_PORT}
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
