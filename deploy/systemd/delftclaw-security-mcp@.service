[Unit]
Description=DelftClaw Security MCP server (instance %i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=delftclaw
Group=delftclaw
WorkingDirectory=/opt/delftclaw
# Per-instance env file dropped at /etc/delftclaw/instances/<instance>.env.
# Must define at least:
#   PYTHONPATH=/opt/delftclaw
#   SECURITY_MCP_PORT=<tcp-port>     (default 7702)
# Optional (for downstream tools that call the gateway):
#   DELFTCLAW_GATEWAY_URL=http://<host>:<port>
EnvironmentFile=/etc/delftclaw/instances/%i.env
ExecStart=/opt/delftclaw/venv/bin/python -m security.integration.start_security_mcp_server \
    --port ${SECURITY_MCP_PORT}
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
