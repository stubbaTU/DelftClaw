[Unit]
Description=DelftClaw Security MCP
After=network-online.target delftclaw-gateway.service
Wants=network-online.target delftclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/root/DelftClaw
Environment=PYTHONPATH=/root/DelftClaw
EnvironmentFile=-/root/DelftClaw/configs/vuk.local.env
ExecStart=/root/DelftClaw/.venv/bin/python -m security.integration.start_security_mcp_server --port 7702
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
