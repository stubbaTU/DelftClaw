# Experiment knobs for the colleagues' gateway + security/* path.
#
# NOT consumed by the v5.2 `make scenario NAME=seek_cc` demo. The
# scenario flow reads `configs/host.env` (per-host overrides like
# LLM_BASE_URL/LLM_MODEL); the v5.2 MCP unit reads per-instance
# values from /etc/delftclaw/instances/<instance>.env written by
# `deploy/scenario_boot.py`. See `configs/README.md` for the split.
#
# This file is the canonical example for the OLDER gateway flow:
#   `security/integration/gateway.py` + the colleagues' subq*
#   experiment scripts + the legacy *.service.template units.
#
# To use:
#   cp configs/template.env configs/yourName.local.env
#   $EDITOR configs/yourName.local.env
# Then point the gateway / experiment script at it via
# DELFTCLAW_ENV_FILE=configs/yourName.local.env or the analogous flag.
#
# Do NOT commit your `*.local.env` — it's gitignored. The fields here
# are placeholders; real bot tokens, wallet seeds, API keys go in the
# local copy, never in this template.

# ---------------------------------------------------------------------------
# Gateway identity + endpoint
# ---------------------------------------------------------------------------
DELFTCLAW_AGENT_ID=name-agent
DELFTCLAW_GATEWAY_HOST=127.0.0.1
DELFTCLAW_GATEWAY_PORT=8765
DELFTCLAW_GATEWAY_URL=http://127.0.0.1:8765
DELFTCLAW_GATEWAY_MODE=defended           # defended | undefended
DELFTCLAW_BAN_THRESHOLD=30
DELFTCLAW_MAX_TOOL_RISK=sensitive

# ---------------------------------------------------------------------------
# Experiment harness — SubQ1 / SubQ2 / SubQ3 condition + log routing
# ---------------------------------------------------------------------------
DELFTCLAW_RUN_ID=dry-run-001
DELFTCLAW_EXPERIMENT_CONDITION=defended
DELFTCLAW_EXPERIMENT_ROOT=real_experiment_workdir
DELFTCLAW_LOG_PATH=logs/template.jsonl

# SubQ2 accountability — Bitcoin-anchor mode for the legacy gateway.
# (The v5.2 community-log path uses the synthetic wallet via host.env's
# BTC_NETWORK=mock instead; this var is read by security/integration/* only.)
DELFTCLAW_BITCOIN_NETWORK=mock
DELFTCLAW_BITCOIN_MIN_CONFIRMATIONS=0
DELFTCLAW_SEEDBOX_AUDIT_INTERVAL_SECONDS=30

# SubQ3 integrity — gVisor sandbox condition + workspace manifest.
DELFTCLAW_SUBQ3_CONDITION=gvisor
DELFTCLAW_SUBQ3_MANIFEST=real_experiment_workdir/runs/subq3-gvisor-dryrun001/subq3_manifest.json

# ---------------------------------------------------------------------------
# Optional bridge: gateway uses the IPv8 OpenClaw PoC identity layer.
# Off by default — the v5.2 stack does not need this. Kept for backward
# compatibility with the colleagues' security tests.
# ---------------------------------------------------------------------------
DELFTCLAW_USE_OPENCLAW_IDENTITY=false
DELFTCLAW_ENABLE_OPENCLAW_P2P=false
DELFTCLAW_OPENCLAW_NETWORK=TESTNET
DELFTCLAW_OPENCLAW_KEY_PATH=
DELFTCLAW_OPENCLAW_P2P_HOST=0.0.0.0
DELFTCLAW_OPENCLAW_P2P_PORT=9000
DELFTCLAW_OPENCLAW_WORKING_DIR=.

# ---------------------------------------------------------------------------
# Legacy P2P agent endpoint (root agent.py — deleted in v5.2 but the
# var name lives on in security/integration/*.py for compat).
# ---------------------------------------------------------------------------
DELFTCLAW_P2P_HOST=0.0.0.0
DELFTCLAW_P2P_PORT=8090
