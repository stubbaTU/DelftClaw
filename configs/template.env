# Copy this file locally to configs/yourName.local.env.
# Do not commit real bot tokens, wallet seeds, API keys, or chat IDs.

DELFTCLAW_AGENT_ID=name-agent
DELFTCLAW_GATEWAY_HOST=127.0.0.1
DELFTCLAW_GATEWAY_PORT=8765
DELFTCLAW_GATEWAY_URL=http://127.0.0.1:8765
DELFTCLAW_GATEWAY_MODE=defended
DELFTCLAW_BAN_THRESHOLD=30
DELFTCLAW_MAX_TOOL_RISK=sensitive
DELFTCLAW_RUN_ID=dry-run-001
DELFTCLAW_EXPERIMENT_CONDITION=defended
DELFTCLAW_EXPERIMENT_ROOT=real_experiment_workdir
DELFTCLAW_SEEDBOX_AUDIT_INTERVAL_SECONDS=30
DELFTCLAW_SUBQ3_CONDITION=gvisor
DELFTCLAW_SUBQ3_MANIFEST=real_experiment_workdir/runs/subq3-gvisor-dryrun001/subq3_manifest.json

DELFTCLAW_P2P_HOST=0.0.0.0
DELFTCLAW_P2P_PORT=8090
DELFTCLAW_LOG_PATH=logs/template.jsonl

# Optional bridge to the repository's IPv8 OpenClaw PoC identity layer.
# When true, the gateway uses the persistent OpenClaw identity hash as its
# local agent id.
DELFTCLAW_USE_OPENCLAW_IDENTITY=false

# When true, the gateway also starts the IPv8 OpenClaw PoC node and exposes
# identity/peer status at /openclaw/status.
DELFTCLAW_ENABLE_OPENCLAW_P2P=false
DELFTCLAW_OPENCLAW_NETWORK=MAINNET
DELFTCLAW_OPENCLAW_KEY_PATH=
DELFTCLAW_OPENCLAW_P2P_HOST=0.0.0.0
DELFTCLAW_OPENCLAW_P2P_PORT=9000
DELFTCLAW_OPENCLAW_WORKING_DIR=.

OPENCLAW_FRONTEND=telegram
