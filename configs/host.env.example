# DelftClaw per-host overrides.
#
# Every developer copies this file to ``configs/host.env`` on their
# laptop / VPS and edits ONLY the variables for that machine. All other
# config (scenario port ranges, watchdog defaults, schema validation,
# etc.) lives in the repo and is shared.
#
# This file is read by:
#
#   * deploy/scenario_boot.py — passes QWEN_BASE_URL / QWEN_MODEL down
#     into each scenario's /etc/delftclaw/instances/<instance>.env.
#   * deploy/vps/bootstrap_security_identity.sh — copies the same
#     QWEN_* + BTC_NETWORK values into the identity/security per-instance
#     env file.
#
# ``configs/host.env`` is GITIGNORED — never commit your real host file.

# --- Tailscale ---
# Tailscale CGNAT IP of the supervisor's GPU host (the box running the
# external Qwen-compatible endpoint). Overridden per dev; not all hosts
# share a tailnet.
TAILSCALE_GPU_IP=100.73.168.12
# This VPS / laptop's hostname on the tailnet. Informational; tools that
# need it look it up at runtime via ``hostname -s``.
TAILSCALE_HOSTNAME=

# --- Compiler / reasoning LLM ---
# OpenAI-compatible base URL the project's compiler-LLM and OpenClaw
# both call. Default points at the supervisor's GPU host over Tailscale.
# To run against local Ollama as the dev/CI fallback:
#   QWEN_BASE_URL=http://127.0.0.1:11434/v1
#   QWEN_MODEL=qwen2.5-coder:7b
QWEN_BASE_URL=http://100.73.168.12:11434/v1
QWEN_MODEL=qwen3.6:27b

# --- Bitcoin (synthetic by default in v5.1) ---
# ``mock`` skips bitcoinlib entirely — pairs with the synthetic
# dclaw1<hex> wallet. ``testnet`` re-enables on-chain admission verification.
BTC_NETWORK=mock
BTC_MIN_CONFIRMATIONS=0

# --- Subproject role(s) this host plays ---
# Comma-separated subset of: communication, identity, security, gateway.
# Dev VPSes typically run all four; security colleagues' boxes run
# identity+security only.
HOST_ROLES=communication
