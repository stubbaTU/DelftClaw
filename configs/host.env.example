# DelftClaw per-host overrides.
#
# Every developer copies this file to ``configs/host.env`` on their
# laptop / VPS and edits ONLY the variables for that machine. All other
# config (scenario port ranges, watchdog defaults, schema validation,
# etc.) lives in the repo and is shared.
#
# This file is read by deploy/scenario_boot.py, which passes QWEN_BASE_URL /
# QWEN_MODEL into each scenario's /etc/delftclaw/instances/<instance>.env.
#
# ``configs/host.env`` is GITIGNORED — never commit your real host file.

# --- Tailscale ---
# Tailscale CGNAT IP of the supervisor's GPU host (the box running the
# external Qwen-compatible endpoint). Overridden per dev; not all hosts
# share a tailnet.
TAILSCALE_GPU_IP=100.73.168.12
# This VPS / laptop's hostname on the tailnet. Informational; tools that
# need it look it up at runtime via ``hostname -s``.
TAILSCALE_HOSTNAME=

# --- Compiler / reasoning LLM ---
# OpenAI-compatible base URL the project's compiler-LLM and OpenClaw
# both call. Default points at the supervisor's GPU host over Tailscale.
# To run against local Ollama as the dev/CI fallback:
#   QWEN_BASE_URL=http://127.0.0.1:11434/v1
#   QWEN_MODEL=qwen2.5-coder:7b
QWEN_BASE_URL=http://100.73.168.12:11434/v1
QWEN_MODEL=qwen3.6:27b
# OpenClaw refuses to register any provider without an ``apiKey``, even
# Ollama which accepts anything as Bearer. The literal value lands both
# in openclaw.json and in the per-instance env file. Override only when
# pointing at a real authenticated proxy in front of Ollama.
OLLAMA_API_KEY=ollama

# Optional pre-watchdog OpenClaw MCP smoke check. Disabled by default while
# hosted providers can rate-limit boot-time smoke calls; direct MCP wallet
# identity checks still run.
OPENCLAW_SMOKE_ENABLED=false
# Smoke timeout if OPENCLAW_SMOKE_ENABLED=true. Hosted models can need more
# than the old 90s budget before they choose and execute the wallet tool.
OPENCLAW_SMOKE_TIMEOUT_S=210
# Retry transient provider throttling during the pre-watchdog smoke check.
# This only retries 429/rate-limit style errors; wrong tool output still fails.
OPENCLAW_SMOKE_ATTEMPTS=3

# --- LLM proxy ---
# scripts/llm_proxy.py forwards OpenAI-compat requests to LLM_PROXY_UPSTREAM
# using one of the keys in LLM_API_KEYS (round-robin with 429/5xx failover).
# Defaults target Anthropic's OpenAI-compat endpoint; override for any
# other OpenAI-shaped provider (Groq, OpenAI itself, vLLM, etc.).

# Optional: use a different reasoning provider for the OpenClaw CLI agent
# subprocess while keeping QWEN_* for DelftClaw's overlay compiler.
# Gemini's OpenAI-compatible API shape:
#   OPENCLAW_PROVIDER=gemini
#   OPENCLAW_API=openai-completions
#   OPENCLAW_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENCLAW_MODEL=gemini-2.0-flash
#   OPENCLAW_API_KEY_ENV=GEMINI_API_KEY
#   GEMINI_API_KEY=<your key>
#
# OpenRouter's OpenAI-compatible API shape:
#   OPENCLAW_PROVIDER=openrouter
#   OPENCLAW_API=openai-completions
#   OPENCLAW_BASE_URL=https://openrouter.ai/api/v1
#   OPENCLAW_MODEL=openai/gpt-4o-mini
#   OPENROUTER_API_KEY=<your key>
#
# To spread four community-demo agents across several free-tier keys, use a
# comma-separated list instead of one key. scenario_boot assigns keys to
# agents in YAML order and wraps around when there are fewer keys than
# agents:
#   GEMINI_API_KEYS=key_1,key_2,key_3,key_4
# or provider-neutral:
#   OPENCLAW_API_KEYS=key_1,key_2,key_3,key_4

# --- Bitcoin (synthetic by default in v5.1) ---
# ``mock`` skips bitcoinlib entirely — pairs with the synthetic
# dclaw1<hex> wallet. ``testnet`` re-enables on-chain admission verification.
BTC_NETWORK=mock
BTC_MIN_CONFIRMATIONS=0
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=admin
BITCOIN_RPC_PASSWORD=admin

# --- Subproject role(s) this host plays ---
# Comma-separated subset of: communication, identity, security, gateway.
# Dev VPSes typically run all four; security colleagues' boxes run
# identity+security only.
HOST_ROLES=communication
